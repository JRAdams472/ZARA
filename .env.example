# Zara env — copy to `.env` and fill in real values. `.env` is gitignored;
# never commit secrets. `docker compose` reads `.env` for ${VAR} interpolation
# and fails closed on any unset ${VAR:?} secret below.
#
# Generate secrets with: openssl rand -hex 32

# --- Secrets (required — no defaults) ---
POSTGRES_PASSWORD=
# Data-plane role passwords (Z1) — provisioned by
# `zara-migrate --set-role-passwords`; never stored in SQL.
ZARA_MIGRATE_PASSWORD=
ZARA_APP_DEV_PASSWORD=
ZARA_APP_QA_PASSWORD=
ZARA_APP_UAT_PASSWORD=
ZARA_APP_PROD_PASSWORD=
ZARA_PROMOTE_PASSWORD=
# Execution engine read role (Z2) — SELECT-only snapshot loader:
ZARA_ENGINE_PASSWORD=
# Management-plane role (Z3) — control-schema grants/secrets/audit:
ZARA_MGMT_PASSWORD=
DEX_ZARA_SVC_SECRET=
DEX_ZARA_CI_SECRET=
SESSION_SECRET=
# Seq admin (first boot only) — salted hash, not plaintext:
#   echo 'your-password' | docker run --rm -i datalust/seq config hash
# Then create an ingest API key via seqcli/UI for SEQ_API_KEY.
SEQ_ADMIN_PASSWORD_HASH=
SEQ_API_KEY=

# --- Data plane (Z1) ---
# Admin DSN for the bootstrap set (role/schema creation):
DATABASE_URL=postgres://zara:__POSTGRES_PASSWORD__@localhost:5532/zara
# Migrate-role DSN for control/env sets — owns objects, subject to FORCE RLS:
MIGRATE_DATABASE_URL=postgres://zara_migrate:__ZARA_MIGRATE_PASSWORD__@localhost:5532/zara

# --- Execution engine (Rust, :8400) — Z2 ---
ENGINE_DATABASE_URL=postgres://zara_engine:__ZARA_ENGINE_PASSWORD__@localhost:5532/zara
# PORT=8400
# RUST_LOG=info,zara_engine=debug,tower_http=info
# SNAPSHOT_POLL_MS=30000          # background fingerprint re-probe (ADR-0004)
# Prod auth — asymmetric alg allowlist (RS256/ES256/EdDSA), keys via JWKS:
# OIDC_ISSUER=http://localhost:5656/dex
# OIDC_AUDIENCE=zara-engine
# OIDC_JWKS_URL=                  # empty = OIDC discovery on the issuer
# Dev/test auth (never prod): static JWKS minted by zara-devtoken — either:
# ZARA_JWKS_FILE=.devkeys/jwks.json
# ZARA_JWKS_JSON={"keys":[...]}   # inline document (alternative to file)
# Rate limits (defaults shown):
# RATE_LIMIT_PER_MIN=240
# RATE_LIMIT_DISABLE=1            # limits off entirely
# RATE_LIMIT_TRUST_XFF=1          # only behind a proxy that overwrites XFF!

# --- Management plane (Node/TS, :8401) — Z3 ---
MGMT_DATABASE_URL=postgres://zara_mgmt:__ZARA_MGMT_PASSWORD__@localhost:5532/zara
# PORT=8401
# LOG_LEVEL=info
# OIDC_ISSUER=http://localhost:5656/dex
# OIDC_AUDIENCE=zara-mgmt
# OIDC_JWKS_URL=                  # empty = OIDC discovery
# ZARA_JWKS_FILE=.devkeys/jwks.json   # dev/test only, never prod
# RATE_LIMIT_PER_MIN=120          # RATE_LIMIT_MUTATIONS_PER_MIN=30
# RATE_LIMIT_DISABLE=1            # RATE_LIMIT_TRUST_XFF=1 (trusted proxy only)
# ENGINE_GRPC_ADDR=localhost:9443
# KMS_PROVIDER=openbao            # openbao | local-kek | cloud — ADR-0003
# KMS_KEY_URI=

# --- Web (BFF, :3400) — lands in milestone Z5 ---
# API_URL=http://localhost:8401
# OIDC_CLIENT_ID=zara-web
# OIDC_REDIRECT_URI=http://localhost:3400/auth/callback
# OIDC_TOKEN_URL=http://localhost:5656/dex/token
# SESSION_SECURE=1               # set for https deployments

# --- Observability (optional; unset = stdout JSON only) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4417
# SEQ_URL=http://localhost:5641/ingest/otlp/v1/logs
